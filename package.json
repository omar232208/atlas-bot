{
  "name": "atlas-discord-bot",
  "version": "0.1.0",
  "description": "Atlas — free open-source multipurpose Discord bot: antiraid, antinuke, automod, moderation, logs, tickets, music, levels, economy, giveaways and a web dashboard. Free hosting on ACLClouds.",
  "main": "index.js",
  "license": "MIT",
  "author": "ACLClouds",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "dry-run": "node -e \"process.env.DRY_RUN='1';require('./index.js')\""
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "multipurpose",
    "moderation",
    "antiraid",
    "antinuke",
    "automod",
    "tickets",
    "music",
    "levels",
    "economy",
    "giveaway",
    "dashboard",
    "free"
  ],
  "optionalDependencies": {
    "@discordjs/voice": "^0.18.0",
    "ffmpeg-static": "^5.3.0",
    "prism-media": "^1.3.5"
  },
  "homepage": "https://github.com/ACL-Cloud/free-multipurpose-discord-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACL-Cloud/free-multipurpose-discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/ACL-Cloud/free-multipurpose-discord-bot/issues"
  }
}
